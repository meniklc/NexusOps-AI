# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the blanks. `.env` is gitignored.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- LLM provider selection -------------------------------------------------
# "openai" uses the OpenAI API (needs OPENAI_API_KEY).
# "ollama" uses a local Ollama server (OpenAI-compatible, no key needed).
# "fake"   uses a deterministic offline provider — no network, no cost.
#          Great for local dev, CI, and running the eval harness for free.
LLM_PROVIDER=fake

# Embedding provider is INDEPENDENT of the chat provider so you can mix them
# (e.g. LLM_PROVIDER=openai + EMBEDDING_PROVIDER=ollama).
# "inherit" (default) reuses whatever LLM_PROVIDER is set to.
# Valid: inherit | openai | ollama | fake
EMBEDDING_PROVIDER=inherit

# --- OpenAI -----------------------------------------------------------------
# Only required when LLM_PROVIDER=openai (or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# text-embedding-3-small is 1536-dim. If you change the embedding model,
# update EMBEDDING_DIM and re-create the DB (the vector column is fixed-width).
EMBEDDING_DIM=1536

# --- Ollama (local, OpenAI-compatible) --------------------------------------
# Only required when LLM_PROVIDER=ollama (or EMBEDDING_PROVIDER=ollama).
# No API key needed. From inside Docker the host's Ollama is host.docker.internal;
# running the backend directly on your host, use http://localhost:11434/v1.
# First: `ollama pull llama3 && ollama pull nomic-embed-text`
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_LLM_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# nomic-embed-text is 768-dim. The pgvector column in db/init.sql (vector(768))
# must match this. Changing it requires `docker compose down -v` + re-ingest.
OLLAMA_EMBEDDING_DIM=768

# --- Database (pgvector) ----------------------------------------------------
# Inside docker-compose the host is "db"; from your host machine use "localhost".
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=ragdb
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Retrieval tuning -------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
RRF_K=60

# --- Web search tool (optional) ---------------------------------------------
# Leave TAVILY_API_KEY blank to use the built-in offline stub.
TAVILY_API_KEY=

# --- Observability: LangSmith (optional) ------------------------------------
# Set LANGCHAIN_TRACING_V2=true and provide a key to trace every graph run.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-rag-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# URL the Streamlit frontend uses to reach the backend.
# In docker-compose this is http://backend:8000; on your host http://localhost:8000
BACKEND_URL=http://localhost:8000
